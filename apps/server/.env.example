# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=vpbot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vpbot

# Строка подключения для Go приложения
# Формат: postgres://user:password@host:port/dbname?sslmode=disable
# "db" — имя сервиса в docker-compose, Docker сам его резолвит
DATABASE_URL=postgres://vpbot:change_me@db:5432/vpbot?sslmode=disable

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
CLINIC_SLUG=default
# Mini App: проверка подписи initData на публичных /api/clinics/... (1 = отключить для локальной разработки)
# TELEGRAM_INITDATA_SKIP=1
# TELEGRAM_INITDATA_MAX_AGE=86400

# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=8080

# ── Админка ──────────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_to_random_string

# ── CORS (опционально) ───────────────────────────────────────────────────────
# Через запятую. По умолчанию: admin/app prod + localhost:5173/5174
# CORS_ORIGINS=https://admin.example.com,https://app.example.com
